* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Montserrat', sans-serif;
    user-select: none;
}

body, html {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: #050515;
    color: #ffffff;
}

/* Background Dynamic Glow & Lightning Atmosphere */
div.bg-gradient {
    position: absolute;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 15% 25%, rgba(0, 102, 255, 0.5) 0%, transparent 45%),
                radial-gradient(circle at 85% 75%, rgba(230, 255, 0, 0.3) 0%, transparent 50%),
                linear-gradient(135deg, #02020a 0%, #0a0d28 50%, #030414 100%);
    z-index: 1;
}

div.bg-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: repeating-linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.02) 0px,
        rgba(255, 255, 255, 0.02) 2px,
        transparent 2px,
        transparent 8px
    );
    z-index: 2;
}

/* Container Utama */
div.container {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 30px 50px;
}

/* Section Atas (Top Bar / Header) */
div.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

div.server-status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #00ffcc;
    text-shadow: 0 0 10px rgba(0, 255, 204, 0.6);
}

span.dot {
    width: 9px;
    height: 9px;
    background-color: #00ffcc;
    border-radius: 50%;
    box-shadow: 0 0 10px #00ffcc;
    animation: pulse 2s infinite;
}

div.version {
    color: rgba(255, 255, 255, 0.6);
}

/* Section Tengah (Logo & Start Prompt) */
div.main-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

div.logo-container {
    margin-bottom: 70px;
}

h1.logo-efootball {
    font-size: 5.8rem;
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: -2px;
    color: #ffffff;
    text-shadow: 0 0 25px rgba(0, 102, 255, 0.8),
                 0 0 50px rgba(0, 102, 255, 0.4);
}

span.e-letter {
    color: #e6ff00; /* Warna kuning neon khas eFootball */
    text-shadow: 0 0 25px rgba(230, 255, 0, 0.9);
}

span.trademark {
    font-size: 1.6rem;
    vertical-align: super;
}

/* Tombol Press Any Button */
div.start-prompt {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 3px;
    color: #ffffff;
    padding: 14px 36px;
    border-left: 4px solid #e6ff00;
    border-right: 4px solid #0066ff;
    background: rgba(5, 10, 30, 0.6);
    backdrop-filter: blur(8px);
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.6);
    animation: blink 1.6s infinite ease-in-out;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
}

div.start-prompt:hover {
    background: rgba(0, 102, 255, 0.2);
    transform: scale(1.03);
}

/* Section Bawah (Footer) */
div.footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 1px;
}

div.legal-links span {
    cursor: pointer;
    transition: color 0.2s ease;
}

div.legal-links span:hover {
    color: #ffffff;
}

/* Transisi Flash saat layar ditekan */
div.screen-flash {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #ffffff;
    z-index: 99;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease-out;
}

div.screen-flash.active {
    opacity: 1;
}

/* Keyframe Animations */
@keyframes blink {
    0%, 100% {
        opacity: 1;
        transform: scale(1);
    }
    50% {
        opacity: 0.35;
        transform: scale(0.98);
    }
}

@keyframes pulse {
    0%, 100% {
        opacity: 1;
    }
    50% {
        opacity: 0.3;
    }
}

